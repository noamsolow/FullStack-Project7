# Copy the server values to server/.env and client values to client/.env.
#
# The repository never contains real secrets. Generate JWT_SECRET with at
# least 32 random bytes before starting the API.

# Server
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=levgo-api
JWT_AUDIENCE=levgo-client
JWT_EXPIRES_IN=1h
ALLOWED_CUSTOMER_EMAIL_DOMAINS=g.jct.ac.il
EMERGENCY_CONTACT_MESSAGE=For an immediate safety risk, contact campus security directly.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=levgo
DB_USER=levgo_app
DB_PASSWORD=replace-with-database-password

DELIVERY_TRACKING_PROVIDER=demo
DEMO_DELIVERY_MIN_SECONDS=30
DEMO_DELIVERY_MAX_SECONDS=60
DELIVERY_TRACKING_INTERVAL_MS=2000

PAYMENTS_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:5173/payment/return
PAYPAL_CANCEL_URL=http://localhost:5173/payment/cancel

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=12000

# Two order notifications are delivered through any standard SMTP account:
# one after successful checkout and one after collection/delivery confirmation.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LevGo <your-email@gmail.com>
SMTP_REPLY_TO=
SMTP_TIMEOUT_MS=10000

# Client
VITE_API_BASE_URL=http://localhost:3000/api
