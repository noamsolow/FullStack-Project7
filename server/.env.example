NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=levgo-api
JWT_AUDIENCE=levgo-client
JWT_EXPIRES_IN=1h
ALLOWED_CUSTOMER_EMAIL_DOMAINS=jct.ac.il
EMERGENCY_CONTACT_MESSAGE=For an immediate safety risk, contact campus security directly.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=levgo
DB_USER=levgo_app
DB_PASSWORD=replace-with-database-password
DB_CONNECTION_LIMIT=10

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:5173/payment/return
PAYPAL_CANCEL_URL=http://localhost:5173/payment/cancel

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=12000

SEED_ADMIN_EMAIL=admin@jct.ac.il
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_CUSTOMER_EMAIL=student@jct.ac.il
SEED_CUSTOMER_PASSWORD=StudentPass123!
SEED_PARTNER_EMAIL=partner@example.com
SEED_PARTNER_PASSWORD=PartnerPass123!
