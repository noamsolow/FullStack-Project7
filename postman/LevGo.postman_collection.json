{
  "info": {
    "_postman_id": "0c156069-b699-4bee-9842-1b3cb244eb8a",
    "name": "LevGo API",
    "description": "Local LevGo acceptance-flow requests. Import LevGo Local as the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Process health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('API is healthy', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Database readiness",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Customer login",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.environment.set('customerToken', body.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/customer/login"
          }
        },
        {
          "name": "Partner login",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.environment.set('partnerToken', body.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{partnerEmail}}\",\n  \"password\": \"{{partnerPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/partner/login"
          }
        },
        {
          "name": "Admin login",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.environment.set('adminToken', body.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/admin/login"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "Buildings", "request": { "method": "GET", "url": "{{baseUrl}}/buildings?limit=50" } },
        { "name": "Eat vendors", "request": { "method": "GET", "url": "{{baseUrl}}/vendors?group=eat&limit=20" } },
        {
          "name": "Vendor products",
          "event": [{ "listen": "test", "script": { "exec": ["const items = pm.response.json().data;", "if (items.length) pm.environment.set('productPublicId', items[0].public_id);"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/vendors/{{vendorSlug}}/products?limit=20" }
        }
      ]
    },
    {
      "name": "Customer workflows",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Recommendation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"budgetAgorot\": 4000,\n  \"needType\": \"study\",\n  \"category\": null,\n  \"dietary\": []\n}" },
            "url": "{{baseUrl}}/recommendations"
          }
        },
        {
          "name": "Checkout pickup",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.data) pm.environment.set('orderPublicId', body.data.orderPublicId);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productId\": \"{{productPublicId}}\", \"quantity\": 1 }],\n  \"fulfillmentType\": \"pickup\"\n}" },
            "url": "{{baseUrl}}/orders/checkout"
          }
        },
        { "name": "My orders", "request": { "method": "GET", "url": "{{baseUrl}}/orders?limit=20" } },
        { "name": "Order details", "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderPublicId}}" } },
        {
          "name": "Create maintenance ticket",
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.data) pm.environment.set('ticketPublicId', body.data.public_id);"] } }],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "buildingId", "value": "1", "type": "text" },
                { "key": "locationText", "value": "Room 214", "type": "text" },
                { "key": "category", "value": "it_equipment", "type": "text" },
                { "key": "title", "value": "Projector is not working", "type": "text" },
                { "key": "description", "value": "The classroom projector does not power on after checking the wall switch.", "type": "text" },
                { "key": "requestedPriority", "value": "normal", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/maintenance-tickets"
          }
        },
        { "name": "Maintenance details", "request": { "method": "GET", "url": "{{baseUrl}}/maintenance-tickets/{{ticketPublicId}}" } }
      ]
    },
    {
      "name": "Partner",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{partnerToken}}", "type": "string" }] },
      "item": [
        { "name": "Vendor workspace", "request": { "method": "GET", "url": "{{baseUrl}}/partner/vendor" } },
        { "name": "Partner products", "request": { "method": "GET", "url": "{{baseUrl}}/partner/products?limit=50" } },
        { "name": "Partner orders", "request": { "method": "GET", "url": "{{baseUrl}}/partner/orders?limit=50" } },
        { "name": "Partner print jobs", "request": { "method": "GET", "url": "{{baseUrl}}/partner/print-jobs?limit=50" } }
      ]
    },
    {
      "name": "Administration",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "item": [
        { "name": "Users", "request": { "method": "GET", "url": "{{baseUrl}}/admin/users?limit=50" } },
        { "name": "Vendors", "request": { "method": "GET", "url": "{{baseUrl}}/admin/vendors?limit=50" } },
        { "name": "Maintenance queue", "request": { "method": "GET", "url": "{{baseUrl}}/admin/maintenance-tickets?limit=50" } },
        { "name": "Audit log", "request": { "method": "GET", "url": "{{baseUrl}}/admin/audit?limit=50" } }
      ]
    }
  ]
}
